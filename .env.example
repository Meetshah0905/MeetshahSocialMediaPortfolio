# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Public site -------------------------------------------------------------
# Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formspree endpoint for the contact form. Leave blank to hide the form and
# show direct contact links instead — the form never posts to a dead endpoint.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Gemini (server only) ----------------------------------------------------
# From Google AI Studio: https://aistudio.google.com/apikey
# Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
# SECURITY: a real key was previously committed here and must be treated as
# exposed — rotate it at https://aistudio.google.com/apikey and put the NEW
# key in .env.local only. This template file holds placeholders, never values.
GEMINI_API_KEY=
# Swappable without a code change. Must be an image-capable model.
GEMINI_MODEL=gemini-2.5-flash
# Optional: Gemini File Search store ID for knowledge sync.
GEMINI_PUBLIC_FILE_SEARCH_STORE=

# --- Meeting booking (public) ------------------------------------------------
NEXT_PUBLIC_MEETING_BOOKING_URL=
NEXT_PUBLIC_CREATOR_TEAM_BOOKING_URL=

# --- Analytics admin (server only) -------------------------------------------
# Login credentials for /admin. REQUIRED — there are no defaults; login fails
# closed until all three values below are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Signs the admin session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SESSION_SECRET=

# --- Upstash Redis (server only) ---------------------------------------------
# Vercel: Storage tab -> Marketplace -> Upstash Redis. Connecting the store
# injects these automatically in preview and production.
# Local: create a database at https://console.upstash.com and paste below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Tally recruitment forms -------------------------------------------------
# Public embed IDs from Tally form URLs (https://tally.so/r/<ID>). Safe to ship
# to the browser — these are not private API credentials.
NEXT_PUBLIC_TALLY_VIDEO_EDITOR_FORM_ID=
NEXT_PUBLIC_TALLY_VIDEOGRAPHER_FORM_ID=
# Optional: set to "false" to pause a role without redeploying.
NEXT_PUBLIC_TALLY_VIDEO_EDITOR_OPEN=
NEXT_PUBLIC_TALLY_VIDEOGRAPHER_OPEN=

# --- Supabase (database & storage) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key (server only)
SUPABASE_SECRET_KEY=

# --- Optional ----------------------------------------------------------------
UPSTASH_DISABLE_TELEMETRY=1
