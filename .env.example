# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# --- Public site -------------------------------------------------------------
# Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formspree endpoint for the contact form. Leave blank to hide the form and
# show direct contact links instead — the form never posts to a dead endpoint.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# --- Gemini (server only) ----------------------------------------------------
# From Google AI Studio: https://aistudio.google.com/apikey
# Never prefix with NEXT_PUBLIC_ — that would ship the key to the browser.
GEMINI_API_KEY=
# Swappable without a code change. Must be an image-capable model.
GEMINI_MODEL=gemini-2.5-flash

# --- Analytics admin (server only) -------------------------------------------
# The passcode for /analytics/admin. Use something long and random.
ANALYTICS_ADMIN_PASSCODE=
# Signs the admin session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_SESSION_SECRET=

# --- Upstash Redis (server only) ---------------------------------------------
# Vercel: Storage tab -> Marketplace -> Upstash Redis. Connecting the store
# injects these automatically in preview and production.
# Local: create a database at https://console.upstash.com and paste below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Optional ----------------------------------------------------------------
UPSTASH_DISABLE_TELEMETRY=1
